#!/usr/bin/env bash
# Privileged half of the portfolio deploy. Installed root-owned at
# /usr/local/sbin/portfolio-deploy and run ONLY through sudo:
#
#   /etc/sudoers.d/portfolio-deploy:
#     deploy ALL=(root) NOPASSWD: /usr/local/sbin/portfolio-deploy
#
# The deploy key's forced command is the unprivileged wrapper
# /usr/local/bin/portfolio-deploy-ssh, which parses SSH_ORIGINAL_COMMAND and
# calls this script with plain arguments. Same split as FinTrack
# (fintrack-deploy-ssh -> sudo fintrack-deploy); `deploy` never gets Docker access.
#
#   portfolio-deploy deploy <image@digest> | rollback | status
set -euo pipefail

APP_DIR=/srv/portfolio
# This script's own installed path (the one in /etc/sudoers.d/portfolio-deploy).
SELF=/usr/local/sbin/portfolio-deploy
COMPOSE=(docker compose --project-name portfolio -f "$APP_DIR/docker-compose.yml")
# compose names it <project>_<volume>; holds the owner's synced files.
DATA_VOLUME=portfolio_cloud-data
# Only images built by this repo's pipeline, pinned by digest.
IMAGE_PATTERN='^ghcr\.io/thijmenbrand/portfolio-v4@sha256:[a-f0-9]{64}$'

# Arguments only: sudo resets the environment, and this script must not trust it.
argv=("$@")
action="${argv[0]:-}"

log() { printf '[portfolio-deploy] %s\n' "$*"; }

# The api writes its SQLite file to a named volume (/data). Docker creates
# that volume root-owned, and the container runs as 65532 with every
# capability dropped, so it can't fix the ownership itself -- it would just
# fail to open the database. Do it here, from the same image, as root.
# Idempotent: safe to repeat on every deploy and rollback.
ensure_data() {  # ensure_data <image>
  docker volume create "$DATA_VOLUME" >/dev/null
  docker run --rm --user 0:0 --entrypoint chown \
    -v "$DATA_VOLUME:/data" "$1" 65532:65532 /data
}

# The server half of a deploy -- this script and the compose file it runs -- is
# installed by hand (deploy/README.md), while the image comes from CI. A commit
# that changes both leaves the server stale until someone remembers, and the
# new image then fails in a way that says nothing about why: cloud sync added a
# /data volume, the old compose file had none, and the api died on an unwritable
# database for 60s of healthcheck before rolling back.
#
# Every image carries the copies it was built with at /app/deploy/. Compare them
# with what is installed, and stop before touching the running deployment, so
# drift reads as one message naming the files instead of a health timeout.
# `docker create` only materialises the filesystem: nothing from the image runs.
check_config() {  # check_config <image>; non-zero if the server half is stale
  local cid tmp rc=0 got=1 pair want have
  tmp="$(mktemp -d)"
  cid="$(docker create "$1")"
  docker cp "$cid:/app/deploy/." "$tmp/" >/dev/null 2>&1 || got=0
  docker rm -v "$cid" >/dev/null
  if (( ! got )); then
    # Images built before this check shipped carry no /app/deploy.
    log "note: $1 has no /app/deploy to compare against; skipping the config check"
    rm -rf "$tmp"
    return 0
  fi
  for pair in "docker-compose.yml:$APP_DIR/docker-compose.yml" \
              "portfolio-deploy:$SELF"; do
    want="$tmp/${pair%%:*}"
    have="${pair#*:}"
    [[ -f "$want" ]] || continue
    if [[ ! -f "$have" ]]; then
      log "missing server config: $have (the image expects it)"
      rc=1
    elif ! cmp -s "$want" "$have"; then
      log "stale server config: $have differs from the copy in $1"
      # -: installed, +: what the image expects.
      diff -u "$have" "$want" | sed "s/^/[portfolio-deploy]   /" || true
      rc=1
    fi
  done
  rm -rf "$tmp"
  (( rc == 0 )) || log "install both files from a checkout of the deployed commit (deploy/README.md), then deploy again"
  return "$rc"
}

start() {  # start <image>; returns non-zero if it doesn't become healthy
  ensure_data "$1"
  IMAGE="$1" "${COMPOSE[@]}" up -d --wait --wait-timeout 60
}

case "$action" in
  deploy)
    image="${argv[1]:-}"
    if [[ ! "$image" =~ $IMAGE_PATTERN ]]; then
      log "refusing image '$image' (expected ghcr.io/thijmenbrand/portfolio-v4@sha256:…)"
      exit 2
    fi
    previous="$(cat "$APP_DIR/current" 2>/dev/null || true)"
    log "pulling $image"
    docker pull --quiet "$image"
    # Before `start`, so a stale server leaves the running deployment alone:
    # nothing has changed yet, and there is nothing to roll back.
    check_config "$image" || exit 3
    if start "$image"; then
      [[ -n "$previous" ]] && printf '%s\n' "$previous" > "$APP_DIR/previous"
      printf '%s\n' "$image" > "$APP_DIR/current"
      # No `docker image prune` here: digest-pulled images are untagged, so it
      # would delete the previous image — the one a rollback needs.
      log "deployed $image"
    else
      log "new image is not healthy"
      if [[ -n "$previous" ]]; then
        log "rolling back to $previous"
        start "$previous"
      fi
      exit 1
    fi
    ;;
  rollback)
    previous="$(cat "$APP_DIR/previous" 2>/dev/null || true)"
    current="$(cat "$APP_DIR/current" 2>/dev/null || true)"
    [[ -n "$previous" ]] || { log "nothing to roll back to"; exit 1; }
    start "$previous"
    printf '%s\n' "$previous" > "$APP_DIR/current"
    printf '%s\n' "$current" > "$APP_DIR/previous"
    log "rolled back to $previous"
    ;;
  status)
    current="$(cat "$APP_DIR/current" 2>/dev/null || true)"
    log "current: ${current:-none}"
    # Reported, never fatal: a way to spot drift without waiting for a deploy.
    [[ -n "$current" ]] && { check_config "$current" || true; }
    "${COMPOSE[@]}" ps
    ;;
  *)
    log "usage: deploy <image@digest> | rollback | status"
    exit 2
    ;;
esac
