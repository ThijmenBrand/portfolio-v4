# API (server/main.ts) settings. Copy to .env for `pnpm dev:api`; in production
# these live in /srv/portfolio/api.env (deploy/README.md).

# The only account.
OWNER_USERNAME=owner
# salthex:hashhex — generate with: read -rs PW && printf '%s' "$PW" | node server/hash.ts
OWNER_PASSWORD_HASH=
# Signs session cookies, at least 32 chars — generate with: openssl rand -hex 32
SESSION_SECRET=
# 2FA for the owner login (base32) — generate with: node server/totp.ts <username>
# and add the printed otpauth:// URI to an authenticator app. Empty = password only.
OWNER_TOTP_SECRET=
# POSTs must carry exactly this Origin (CSRF check). Vite's dev server:
PUBLIC_ORIGIN=http://localhost:5173
# "production" adds Secure to the session cookie.
NODE_ENV=development

# Cloud filesystem (/mnt/cloud): the SQLite file holding the owner's synced
# app data. In production it sits on a Docker volume (deploy/README.md); for
# `pnpm dev:api` a path next to the repo is fine, and :memory: forgets
# everything on restart.
CLOUD_DB=./cloud.db

# Aliases app (optional). SimpleLogin → Settings → API Keys. Without it the
# app shows an error; the rest of the API is unaffected.
SIMPLELOGIN_API_KEY=
